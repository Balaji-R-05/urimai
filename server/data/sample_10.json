      "Kalaignar Magalir Urimai",
      "மகளிர் உரிமைத் தொகை"
    ],
    "benefit": {
      "summary": {
        "en": "₹1,000 a month to women heads of family",
        "ta": "குடும்பத் தலைவிகளுக்கு மாதம் ₹1,000"
      },
      "annual_cash_value_inr": 12000
    },
    "eligibility": {
      "all": [
        {
          "field": "gender",
          "op": "eq",
          "value": "female"
        },
        {
          "field": "age",
          "op": "gte",
          "value": 21
        },
        {
          "field": "is_head_of_family",
          "op": "is_true"
        },
        {
          "field": "annual_family_income",
          "op": "lte",
          "value": 250000
        }
      ],
      "any": [],
      "none": [
        {
          "field": "is_govt_employee",
          "op": "is_true"
        },
        {
          "field": "is_income_tax_payer",
          "op": "is_true"
        }
      ],
      "other": []
    },
    "documents": [
      "aadhaar",
      "ration_card",
      "bank_passbook",
      "electricity_bill"
    ],
    "application": {
      "mode": "both",
      "where": {
        "en": "Special camps / ration shop area, or kmut.tn.gov.in",
        "ta": "சிறப்பு முகாம்கள் / நியாயவிலைக் கடை பகுதி அல்லது kmut.tn.gov.in"
      },
      "url": "https://kmut.tn.gov.in/",
      "steps": {
        "en": [
          "Collect the application at your ration shop or camp",
          "Fill it with Aadhaar, ration card, bank and electricity details",
          "Submit at the camp; field verification follows",
          "₹1,000 is credited on the 15th of each month"
        ],
        "ta": [
          "நியாயவிலைக் கடை அல்லது முகாமில் விண்ணப்பம் பெறவும்",
          "ஆதார், ரேஷன் கார்டு, வங்கி, மின் இணைப்பு விவரங்களுடன் நிரப்பவும்",
          "முகாமில் சமர்ப்பிக்கவும்; களச் சரிபார்ப்பு நடக்கும்",
          "ஒவ்வொரு மாதமும் 15ஆம் தேதி ₹1,000 வரவு வைக்கப்படும்"
        ]
      }
    },
    "source": {
      "url": "https://kmut.tn.gov.in/",
      "origin": "manual"
    },
    "verification": {
      "status": "unverified"
    },

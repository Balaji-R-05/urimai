# Copy to .env and fill in. Shared by server/ and bot/.

# --- Telegram bot (bot/) ---
TELEGRAM_BOT_TOKEN=
BACKEND_URL=http://localhost:8000
BACKEND_TIMEOUT_S=30
DEFAULT_LANG=ta
VOICE_REPLIES_DEFAULT=1
MAX_VOICE_SECONDS=60

# --- API server (server/) ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=8
STT_MODEL=whisper-large-v3
SESSION_TTL_S=1800

# Scheme catalogue. Leave MONGODB_URI empty to use server/data/schemes.json.
# Load the JSON into MongoDB with:  cd server && python -m app.catalogue.seed
MONGODB_URI=
MONGODB_DB=urimai
MONGODB_COLLECTION=schemes

# Scheme Q&A retrieval (models download once into server/.models, ~1.3 GB)
RETRIEVAL_ENABLED=1
RETRIEVAL_TIMEOUT_S=4
RETRIEVAL_MIN_SCORE=0.3
# atlas = MongoDB Atlas Vector Search + Atlas Search (default when MONGODB_URI is set); memory = in-process
RETRIEVAL_BACKEND=
MONGODB_CHUNKS_COLLECTION=scheme_chunks
RERANK_POOL=20
# Log every MongoDB call in the server output
LOG_DB_CALLS=1
